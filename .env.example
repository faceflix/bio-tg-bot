# ===== BOT SETTINGLARI (BotFather'dan olasiz) =====
# Bot tokeni (masalan: 123456:ABC-DEF...)
BOT_TOKEN=

# Botning username'i "@"siz (masalan: bio_test_bot)
BOT_USERNAME=

# Testlardan foydalanish uchun a'zo bo'linadigan kanal username'i (masalan: bio_test_channel)
CHANNEL_USERNAME=

# Kanal havolasi (ixtiyoriy, ko'rsatilmasa t.me/<username> ishlatiladi)
CHANNEL_URL=

# ===== MA'LUMOTLAR BAZASI =====
# Lokal ishlatish uchun: file:data/db.sqlite (qo'lda hech narsa kerak emas)
# Bulut (Render) uchun Turso'dan: libsql://<dbname>-<org>.turso.io
DATABASE_URL=file:data/db.sqlite

# Turso uchun auth token (lokal file uchun bo'sh qoldiring)
DATABASE_AUTH_TOKEN=

# O'qituvchi paneli uchun parol (bitta ustoz)
ADMIN_PASSWORD=

# ===== SERVER =====
# Port (Render avtomatik beradi, standart: 3000)
PORT=3000

# Sessiya shifrlash uchun maxfiy kalit (ixtiyoriy, o'zgartirsa ham bo'ladi)
SESSION_SECRET=change-me-to-a-random-string

# Faqat lokal sinash uchun: 1 bo'lsa Telegram tokensiz kirishga ruxsat beradi.
# Ishlab chiqarishda har doim o'chiring yoki 0 qiling!
DEV_AUTH=0

# ===== E'TİROZLAR =====
# E'tirozlar yuboriladigan Telegram guruh/kanal chat_id (ixtiyoriy).
# Bo'sh qoldirilsa, e'tirozlar faqat admin panelda ko'rinadi.
# Misol: -1001234567890
FEEDBACK_CHAT_ID=

# ===== PULLIK TESTLAR =====
# To'lov qilinadigan karta raqami (to'lov modalida talabaga ko'rsatiladi).
# Bo'sh qoldirilsa, pullik test to'lov ma'lumotisiz ko'rinadi.
# Misol: 9860 0000 0000 0000
PAYMENT_CARD=
